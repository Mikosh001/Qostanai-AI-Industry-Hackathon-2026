<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/quiz/accessrule/sergek/db" VERSION="20261006" COMMENT="Sergek per-quiz settings">
 <TABLES><TABLE NAME="quizaccess_sergek" COMMENT="Per quiz requirement">
  <FIELDS><FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
