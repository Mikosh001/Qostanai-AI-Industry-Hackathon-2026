  </KEYS><INDEXES><INDEX NAME="userquiz" UNIQUE="true" FIELDS="userid,quizid"/><INDEX NAME="nonce" UNIQUE="true" FIELDS="nonce"/></INDEXES>
 </TABLE></TABLES>
</XMLDB>
